{
  "name": "python-uv-monorepo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",

  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_COMPILE_BYTECODE": "1",
    "UV_PROJECT_ENVIRONMENT": "/workspaces/${localWorkspaceFolderBasename}/.venv",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv"
  },

  // Runs once at container creation time AND is captured by Codespaces prebuilds.
  // Kept deliberately trivial — anything that can fail here kills the whole
  // container creation (error 1302), so no dependency resolution belongs here.
  "onCreateCommand": "uv --version && uv python pin 3.13",

  // Heavy dependency install lives in postCreateCommand, NOT updateContentCommand,
  // until a uv.lock is committed to the repo. onCreateCommand/updateContentCommand
  // failures are FATAL and abort container creation with no way to shell in and
  // debug; postCreateCommand failures are non-fatal, so you always get a working
  // container even if a package install has a problem.
  //
  // NOTE (once uv.lock exists and is committed — see step 3 in chat): move this
  // exact line into "updateContentCommand" instead, and add --locked back, so
  // Codespaces prebuilds bake the install in. Until then, leave it here.
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  // Runs every time the Codespace starts/resumes. Cheap safety-net re-sync:
  // near-instant if the lockfile hasn't changed since last sync. Never fatal.
  "postStartCommand": "uv sync --all-groups >/tmp/uv-sync.log 2>&1 || true",

  "forwardPorts": [8000, 8888],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "upgradePackages": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}