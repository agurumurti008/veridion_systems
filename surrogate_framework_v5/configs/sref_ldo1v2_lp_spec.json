  "bridges": {
    "DC.operating_point": {
      "transient_effect": "initial_condition",
      "formula": "x0 = DC_OP(params)",
      "enabled": true,
      "transient_weight": 0.9
    },
    "DC.dropout_constrains_vout": {
      "transient_effect": "output_voltage_floor",
      "formula": "VOUT_min = VIN_min - Vdropout_max",
      "enabled": true,
      "transient_weight": 0.9
    },
    "AC.output_impedance_to_psrr": {
      "transient_effect": "psrr_at_1mhz",
      "formula": "PSRR_dB = 20*log10(Zout_open / Zout_closed)",
      "enabled": true,
      "transient_weight": 0.8
    },
    "PSRR.psrr_1mhz_to_noise": {
      "transient_effect": "output_noise_rms",
      "formula": "Noise_out = Noise_in / 10^(PSRR_dB/20)",
      "enabled": true,
      "transient_weight": 0.8
    },
    "TRANSIENT.undershoot_to_settling": {
      "transient_effect": "settling_time",
      "formula": "settling_time increases with undershoot amplitude through the dominant pole-zero pair",
      "enabled": true,
      "transient_weight": 0.5
    }
  },
